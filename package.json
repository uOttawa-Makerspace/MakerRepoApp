    "@popperjs/core": "^2.11.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "axios": "^1.18.0",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.10",
    "eslint-config-airbnb": "^19.0.4",
    "gh-pages": "^6.3.0",
    "html-react-parser": "^6.1.3",
    "postcss": "^8.5.18",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
